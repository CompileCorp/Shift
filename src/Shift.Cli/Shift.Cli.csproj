<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Compile.Shift.Cli</RootNamespace>
        <!-- NuGet Package Metadata: published as a .NET global tool invoked as `shift` -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>shift</ToolCommandName>
        <PackageId>Compile.Shift.Cli</PackageId>
        <VersionSuffix></VersionSuffix>
        <Authors>Compile Pty Ltd</Authors>
        <Company>Compile Pty Ltd</Company>
        <Description>The Shift command-line tool: apply DMD schema definitions to SQL Server, export a database back to DMD, and generate EF Core and DBML output</Description>
        <PackageProjectUrl>https://github.com/CompileCorp/Shift</PackageProjectUrl>
        <RepositoryUrl>https://github.com/CompileCorp/Shift</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>database;migration;sql;dotnet;cli;dotnet-tool;dbml</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CompileCorp.Vnum" Version="1.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.19" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.19" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.19" />
        <PackageReference Include="MediatR" Version="12.5.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shift\Shift.csproj" />
        <ProjectReference Include="..\Shift.Dbml\Shift.Dbml.csproj" />
        <!-- Shift.Ef publishes no package, so it must never become a package dependency. A tool
             package bundles its publish output and emits no dependencies at all, so this is inert
             today; it matters if the CLI ever stops packing as a tool. Shift and Shift.Dbml need
             no such guard - both publish at this same version. -->
        <ProjectReference Include="..\Shift.Ef\Shift.Ef.csproj" PrivateAssets="all" />
    </ItemGroup>

</Project>
